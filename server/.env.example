# ---------------------------------------------------------------------------
# OpenToDo server — environment variables (BetterAuth auth layer)
# Copy to `.env` and fill in. The server reads these at startup.
# ---------------------------------------------------------------------------

# BetterAuth session-cookie signing key. MUST be >= 32 chars and kept secret in
# production. The default below is only safe for local development.
BETTER_AUTH_SECRET=dev-better-auth-secret-replace-in-production

# Base URL the auth server advertises; also the value the CSRF Origin check
# compares against on sign-in/sign-up POSTs.
BETTER_AUTH_URL=http://localhost:4000

# Auth database (node:sqlite). Auth tables are kept SEPARATE from the app's
# todos database (see DB_PATH below). Use a file path in production; `:memory:`
# is fine for local dev only (users/sessions reset on restart).
# The `user`, `session`, `account`, and `verification` tables are created by
# running BetterAuth migrations on startup (initAuth) — the DB file does not
# need to pre-exist.
BETTER_AUTH_DB_PATH=:memory:

# Comma-separated list of additional Origins the auth server may serve (CSRF
# / sign-in redirects). The Vite dev server at http://localhost:5173 is
# always trusted by code in auth.ts; add other deployment origins here, e.g.
# https://app.example.com,https://staging.example.com
BETTER_AUTH_TRUSTED_ORIGINS=

# --- OAuth social providers (optional) -------------------------------------
# Each provider is activated only when BOTH its id and secret are set. Leave
# blank to disable that provider. X (formerly Twitter) is configured under the
# BetterAuth `twitter` provider key — set TWITTER_CLIENT_ID/SECRET to enable
# "Sign in with X/Twitter".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
