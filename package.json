{
  "name": "opentodo",
  "private": true,
  "version": "0.0.0",
  "description": "A Trello-like boards/lists/cards app (To-Do MVP).",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server",
    "lint": "npm run lint --workspace=server",
    "test": "npm run test --workspace=server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build --workspace=server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
